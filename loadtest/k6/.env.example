# Staging environment configuration for k6 load tests

# Base URL for the staging environment
K6_BASE_URL=https://staging.mediscan.cloud

# Test user credentials - reuses the account already seeded by
# database/seeders/DatabaseSeeder.php (plaintext in source, not a secret).
# NOT guaranteed to exist on staging automatically - deploy.yml only runs
# RoleAndPermissionSeeder on deploy, not the full DatabaseSeeder. Verify
# with a login curl first; if missing, seed it once via:
#   docker compose run --rm app php artisan db:seed --force
K6_TEST_USER_EMAIL=test@example.com
K6_TEST_USER_PASSWORD=password

# Optional: k6 Cloud token (for running tests in the cloud)
# Get one from https://app.k6.io/account/api-token
# K6_CLOUD_TOKEN=

# Optional: Maximum number of VUs (limit memory usage)
# K6_MAX_VUS=300

# Optional: Custom output format
# K6_OUT=json=results.json,csv=results.csv
