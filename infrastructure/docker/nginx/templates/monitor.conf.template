server {
    listen 80;
    server_name ${NGINX_MONITOR_HOST};

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${NGINX_MONITOR_HOST};

    ssl_certificate     /etc/nginx/tls/origin.crt;
    ssl_certificate_key /etc/nginx/tls/origin.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Docker's embedded DNS - resolved per-request via a variable (not a
    # static `upstream` block) so nginx doesn't refuse to start if grafana
    # isn't resolvable yet at boot.
    resolver 127.0.0.11 valid=10s;

    location / {
        set $grafana_upstream grafana:3000;
        proxy_pass http://$grafana_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_buffer_size 128k;
        proxy_buffers 24 128k;

        # Grafana Live (WebSocket) support
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
