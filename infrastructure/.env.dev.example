APP_NAME=Mediscan
APP_ENV=local
INERTIA_SSR_ENABLED=false
APP_DEBUG=true
APP_URL=https://localhost
APP_KEY=

LOG_CHANNEL=stderr
LOG_DEPRECATIONS_CHANNEL=null

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=mediscan
DB_USERNAME=mediscan
DB_PASSWORD=mediscan

SESSION_DRIVER=redis
SESSION_LIFETIME=120

CACHE_STORE=redis

QUEUE_CONNECTION=redis

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

BROADCAST_CONNECTION=reverb

FILESYSTEM_DISK=s3
# Must match RUSTFS_ACCESS_KEY
AWS_ACCESS_KEY_ID=devaccesskey
# Must match RUSTFS_SECRET_KEY
AWS_SECRET_ACCESS_KEY=devsecretkey
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mediscan
AWS_URL=https://localhost/cdn
AWS_ENDPOINT=http://rustfs:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

REVERB_APP_ID=local
REVERB_APP_KEY=localdevkey
REVERB_APP_SECRET=localdevsecret
REVERB_HOST=localhost
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_BROADCAST_HOST=reverb
REVERB_SCALING_ENABLED=false

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

MACHINE_LEARNING_BASE_URL=http://machine-learning:8500
MACHINE_LEARNING_SHARED_SECRET=localdevsecret
KYC_FACE_MATCH_HARD_FLOOR=0.4

# Mailpit catches all outgoing mail locally - view at http://localhost:8025
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null

RUSTFS_ACCESS_KEY=devaccesskey
RUSTFS_SECRET_KEY=devsecretkey
RUSTFS_CORS_ALLOWED_ORIGINS=https://localhost
